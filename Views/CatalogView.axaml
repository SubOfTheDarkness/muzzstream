<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:muzzstream.Models"
             xmlns:vm="using:muzzstream.ViewModels"
             xmlns:controls="using:muzzstream.Controls"
             x:Class="muzzstream.Views.CatalogView"
             x:DataType="vm:CatalogViewModel"
             Background="#121212">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25" Spacing="25">
            
            <StackPanel Spacing="10">
                <TextBlock Text="Поиск" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                         Background="#242424" BorderBrush="#333333" Foreground="White"
                         Padding="12,10" CornerRadius="8"/>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsSearchResultsVisible}" Spacing="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Исполнители" FontSize="16" FontWeight="SemiBold" Foreground="#1DB954"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FoundArtists}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="15"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" Padding="0" Click="ArtistButton_Click" CommandParameter="{Binding}">
                                        <Border Background="#181818" Padding="15,10" CornerRadius="20" BorderBrush="#282828" BorderThickness="1">
                                            <TextBlock Text="{Binding}" Foreground="White" FontWeight="Medium"/>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Альбомы" FontSize="16" FontWeight="SemiBold" Foreground="#1DB954"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FoundAlbums}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="15"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" Padding="0" Click="AlbumButton_Click" CommandParameter="{Binding}">
                                        <Border Background="#181818" Padding="20,15" CornerRadius="8" BorderBrush="#282828" BorderThickness="1" Width="140">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="💿" FontSize="24" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding}" Foreground="White" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="15">
                <Grid IsVisible="{Binding IsTopTracksVisible}" ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Text="{Binding CurrentViewTitle}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <Button Grid.Column="1" 
                        x:Name="RefreshCatalogBtn"
                        Click="RefreshCatalogBtn_Click"
                        Content="🏠" 
                        Background="#282828" 
                        Foreground="#1DB954" 
                        FontWeight="SemiBold" 
                        Padding="12,6" 
                        CornerRadius="6"
                        VerticalAlignment="Center"/>
                </Grid>
                
                <ItemsControl ItemsSource="{Binding DisplayedTracks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:TrackModel">
                            <Border Background="#181818" CornerRadius="6" Padding="12,8" BorderBrush="#242424" BorderThickness="1">
                                <Grid ColumnDefinitions="45, *, *, 40, 80">
                                    <Button Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#282828"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Click="TrackPlayButton_Click" CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding ui_play_icon}" Foreground="#1DB954" FontWeight="Bold" FontSize="12"/>
                                    </Button>
                                    
                                    <Border Grid.Column="1" MaxWidth="300" HorizontalAlignment="Left" ClipToBounds="True">
                                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                            <controls:MarqueeTextBlock Text="{Binding composition_name}" 
                                                                    FontWeight="SemiBold" 
                                                                    Foreground="White"
                                                                    FontSize="14"/>
                                            <Button Background="Transparent" Padding="0" Click="ArtistClickFromTrack" CommandParameter="{Binding authors_list}" HorizontalAlignment="Left">
                                                <controls:MarqueeTextBlock Text="{Binding authors_list}" FontSize="12" Foreground="#1DB954"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="2" Background="Transparent" Padding="0" Click="AlbumClickFromTrack" CommandParameter="{Binding album_name}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding album_name}" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                    <Button Grid.Column="3" Width="28" Height="28" CornerRadius="4" Background="Transparent" 
                                            Click="AddToPlaylistClick" CommandParameter="{Binding}" 
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="5,0,0,0">
                                        <TextBlock Text="+" Foreground="#A7A7A7" FontSize="16" FontWeight="Bold"/>
                                    </Button>
                                    <TextBlock Grid.Column="4" Text="{Binding formatted_duration}" Foreground="#AAAAAA" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
