<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:muzzstream.ViewModels"
             x:Class="muzzstream.Views.AddToPlaylistDialog"
             x:DataType="vm:AddToPlaylistViewModel"
             Background="#1E1E1E"
             Padding="20"
             Width="400"
             CornerRadius="12">

    <StackPanel Spacing="15">
        <TextBlock Text="Добавить в плейлист" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

        <TextBlock x:Name="StatusMessageTextBlock"
                   Text="{Binding StatusMessage}" 
                   FontSize="12" 
                   TextWrapping="Wrap" 
                   HorizontalAlignment="Center"
                   IsVisible="{Binding !!StatusMessage}"/>

        <TextBlock Text="Выберите ваши плейлисты:" FontSize="13" Foreground="#A7A7A7"/>
        <Border Background="#121212" CornerRadius="8" Padding="5" Height="150" BorderBrush="#333333" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Playlists}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlaylistSelectItem">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="10,4" Foreground="White">
                                <TextBlock Text="{Binding Playlist.playlist_name}" TextTrimming="CharacterEllipsis"/>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Separator Background="#333333" Margin="0,5"/>

        <TextBlock Text="Или создать новый:" FontSize="13" Foreground="#A7A7A7"/>
        
        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
            
            <TextBox Grid.Row="0" 
                     Grid.Column="0" 
                     Text="{Binding NewPlaylistName, Mode=TwoWay}" 
                     PlaceholderText="Название нового плейлиста" 
                     Background="#2A2A2A" 
                     Foreground="White" 
                     Padding="8,6" 
                     CornerRadius="6"
                     Margin="0,0,10,8"/>
            
            <Button Grid.Row="0" 
                    Grid.Column="1" 
                    Content="Создать" 
                    Click="CreatePlaylistBtn_Click" 
                    Background="#282828" 
                    Foreground="#1DB954" 
                    Padding="12,6" 
                    CornerRadius="6"
                    Margin="0,0,0,8"/>
            
            <CheckBox Grid.Row="1" 
                      Grid.Column="0" 
                      Grid.ColumnSpan="2" 
                      IsChecked="{Binding IsNewPlaylistPublic, Mode=TwoWay}" 
                      Foreground="#A7A7A7" 
                      FontSize="12" 
                      Content="Сделать плейлист публичным"
                      Margin="0,4,0,0"/>
        </Grid>

        <Separator Background="#333333" Margin="0,5"/>

        <Grid ColumnDefinitions="*, *">
            <Button Grid.Column="0" Content="Отмена" Click="CancelBtn_Click" Background="Transparent" Foreground="#FF3333" HorizontalAlignment="Center" Padding="20,8"/>
            <Button Grid.Column="1" Content="Добавить" Click="SaveBtn_Click" Background="#1DB954" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Padding="25,8" CornerRadius="6"/>
        </Grid>
    </StackPanel>
</UserControl>
